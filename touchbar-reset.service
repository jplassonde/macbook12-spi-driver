[Unit]
Description=USB Reset for Apple iBridge
After=multi-user.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash -c "echo '1-3' | tee /sys/bus/usb/drivers/usb/unbind; sleep 1; echo '1-3' | tee /sys/bus/usb/drivers/usb/bind"
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
